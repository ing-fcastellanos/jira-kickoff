# Copia este archivo a .env y rellena los valores.
# El unico secreto del proyecto es el API token de Jira: GitHub se resuelve
# con el Credential Manager que git ya tiene autenticado.

# Correo de tu cuenta Atlassian.
JIRA_EMAIL=tu.correo@ejemplo.com

# Token de API de Jira. Se genera en:
# https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_API_TOKEN=

# Opcional. Por defecto 8787.
# PORT=8787
